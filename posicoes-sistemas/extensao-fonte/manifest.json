{
  "manifest_version": 3,
  "name": "BFR Wyscout — Posições e Sistemas",
  "version": "1.2.1",
  "description": "Deixa o app Posições e Sistemas (Botafogo Analytics) buscar no Wyscout em que você está logado: jogos do jogador e sistema das equipes, ano a ano.",
  "key": "",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://wyscout.hudl.com/*",
    "https://searchapi.wyscout.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://henriquesimoessilva3-png.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}